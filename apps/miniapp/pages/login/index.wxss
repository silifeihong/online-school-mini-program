.login-container {
  min-height: 100vh;
  padding: 80rpx 48rpx;
  background: #ffffff;
}

.form-wrapper {
  width: 100%;
}

.form-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #182230;
  margin-bottom: 64rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-input {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 28rpx 24rpx;
  font-size: 28rpx;
}

.password-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.password-input {
  flex: 1;
  padding-right: 88rpx;
}

.eye-icon {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  padding: 8rpx;
  box-sizing: content-box;
}

.forgot-password {
  text-align: right;
  color: #2563eb;
  font-size: 26rpx;
  margin-bottom: 48rpx;
}

.btn-login {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #e5e7eb;
  color: #9ca3af;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
  border: none;
}

.btn-login.active {
  background: #2563eb;
  color: #ffffff;
}

.btn-wechat {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #07c160;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.register-entry {
  text-align: center;
  margin-top: 48rpx;
  color: #6b7280;
  font-size: 26rpx;
}

.link {
  color: #2563eb;
}
