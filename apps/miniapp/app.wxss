/* 全局样式 */
page {
  background-color: #f7f8fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Noto Sans SC', 'Helvetica Neue',
    'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #182230;
  line-height: 1.5;
}

/* 主色调 */
.text-primary {
  color: #2563eb;
}

.bg-primary {
  background-color: #2563eb;
}

/* 通用间距 */
.container {
  padding: 32rpx;
}

/* 卡片样式 */
.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* 按钮样式 */
.btn-primary {
  background: #2563eb;
  color: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-secondary {
  background: #f0f2f5;
  color: #182230;
  border-radius: 12rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 32rpx;
}

/* 输入框 */
.input {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.input-focus {
  background: #ffffff;
  box-shadow: 0 0 0 2rpx #2563eb;
}

/* 文本颜色 */
.text-gray {
  color: #999999;
}

.text-dark {
  color: #182230;
}

.text-danger {
  color: #e34d59;
}

/* 间距 */
.mt-16 {
  margin-top: 16rpx;
}

.mt-24 {
  margin-top: 24rpx;
}

.mt-32 {
  margin-top: 32rpx;
}

.mb-16 {
  margin-bottom: 16rpx;
}

.mb-24 {
  margin-bottom: 24rpx;
}

.mb-32 {
  margin-bottom: 32rpx;
}
