<view class="register-container">
  <view class="form-wrapper">
    <view class="form-title">注册账号</view>

    <!-- 邮箱输入 -->
    <view class="form-item">
      <input
        class="form-input"
        type="text"
        placeholder="请输入邮箱"
        bindinput="onEmailInput"
      />
    </view>

    <!-- 验证码 -->
    <view class="form-item code-item">
      <input
        class="form-input code-input"
        type="number"
        maxlength="6"
        placeholder="请输入验证码"
        bindinput="onCodeInput"
      />
      <button
        class="btn-send-code {{canSendCode ? 'active' : ''}}"
        disabled="{{!canSendCode}}"
        bindtap="handleSendCode"
      >
        {{countdown > 0 ? countdown + 's' : '获取验证码'}}
      </button>
    </view>

    <!-- 密码输入 -->
    <view class="form-item">
      <input
        class="form-input"
        password="{{true}}"
        placeholder="请输入密码（8位以上）"
        bindinput="onPasswordInput"
      />
    </view>

    <!-- 确认密码 -->
    <view class="form-item">
      <input
        class="form-input"
        password="{{true}}"
        placeholder="请确认密码"
        bindinput="onConfirmPasswordInput"
      />
    </view>

    <!-- 注册按钮 -->
    <button
      class="btn-register {{canSubmit ? 'active' : ''}}"
      disabled="{{!canSubmit || isLoading}}"
      bindtap="handleRegister"
    >
      {{isLoading ? '注册中...' : '注册'}}
    </button>

    <!-- 登录入口 -->
    <view class="login-entry">
      已有账号？
      <text class="link" bindtap="goLogin">立即登录</text>
    </view>
  </view>
</view>
