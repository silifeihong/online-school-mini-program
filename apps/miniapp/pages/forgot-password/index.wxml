<view class="forgot-container">
  <view class="form-wrapper">
    <view class="form-title">忘记密码</view>
    <view class="form-desc">验证码将发送至以下已确认的邮箱</view>

    <!-- 邮箱（确认账号页已校验，只读展示） -->
    <view class="form-item">
      <view class="email-display">{{email}}</view>
    </view>

    <!-- 验证码 -->
    <view class="form-item code-item">
      <input
        class="form-input code-input"
        type="number"
        maxlength="6"
        placeholder="请输入6位验证码"
        bindinput="onCodeInput"
      />
      <button
        class="btn-send-code {{countdown === 0 ? 'active' : ''}}"
        disabled="{{countdown > 0}}"
        bindtap="handleSendCode"
      >
        {{countdown > 0 ? countdown + 's' : '获取验证码'}}
      </button>
    </view>

    <!-- 新密码 -->
    <view class="form-item">
      <input
        class="form-input"
        password="{{true}}"
        placeholder="新密码（8-20位，含字母和数字）"
        bindinput="onNewPasswordInput"
      />
    </view>

    <!-- 确认密码 -->
    <view class="form-item">
      <input
        class="form-input"
        password="{{true}}"
        placeholder="确认新密码"
        bindinput="onConfirmPasswordInput"
      />
    </view>

    <!-- 提交 -->
    <button
      class="btn-next {{canSubmit ? 'active' : ''}}"
      disabled="{{!canSubmit || isLoading}}"
      bindtap="handleSubmit"
    >
      {{isLoading ? '重置中...' : '重置密码'}}
    </button>

    <view class="back-link" bindtap="goBack">返回登录</view>
  </view>
</view>
