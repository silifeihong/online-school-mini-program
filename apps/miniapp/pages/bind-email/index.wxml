<view class="bind-container">
  <view class="form-wrapper">
    <view class="form-title">绑定邮箱</view>
    <view class="form-desc">微信账号需要绑定邮箱后才能使用</view>

    <!-- 邮箱 -->
    <view class="form-item">
      <input class="form-input" type="text" placeholder="请输入邮箱" bindinput="onEmailInput" />
    </view>

    <!-- 验证码 -->
    <view class="form-item code-item">
      <input class="form-input code-input" type="number" maxlength="6" placeholder="验证码" bindinput="onCodeInput" />
      <button class="btn-send-code {{canSendCode ? 'active' : ''}}" disabled="{{!canSendCode}}" bindtap="handleSendCode">
        {{countdown > 0 ? countdown + 's' : '获取验证码'}}
      </button>
    </view>

    <!-- 关联模式提示（邮箱已注册未绑微信） -->
    <view wx:if="{{mode === 'link'}}" class="form-tip">
      该邮箱已注册，输入验证码后将直接关联微信
    </view>

    <!-- 新建模式提示（邮箱未注册，让用户可察觉邮箱输错） -->
    <view wx:elif="{{mode === 'create'}}" class="form-tip create">
      该邮箱未注册，绑定成功后将自动创建新账号
    </view>

    <!-- 密码（仅新建模式展示） -->
    <view class="form-item" wx:if="{{mode === 'create'}}">
      <input class="form-input" password="{{true}}" placeholder="设置密码（8-20位，含字母和数字）" bindinput="onPasswordInput" />
    </view>

    <!-- 绑定按钮 -->
    <button class="btn-bind" bindtap="handleBind" disabled="{{isLoading}}">
      {{isLoading ? '绑定中...' : '绑定'}}
    </button>
  </view>
</view>
