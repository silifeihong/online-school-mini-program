<view class="login-container">
  <view class="form-wrapper">
    <view class="form-title">欢迎登录</view>

    <!-- 邮箱输入 -->
    <view class="form-item">
      <input
        class="form-input"
        type="text"
        placeholder="请输入邮箱"
        bindinput="onEmailInput"
      />
    </view>

    <!-- 密码输入（默认密文，眼睛图标切换明文） -->
    <view class="form-item">
      <view class="password-wrapper">
        <input
          class="form-input password-input"
          password="{{!passwordVisible}}"
          placeholder="请输入密码"
          bindinput="onPasswordInput"
        />
        <image
          class="eye-icon"
          src="{{passwordVisible ? '/static/images/eye-open.png' : '/static/images/eye-closed.png'}}"
          mode="aspectFit"
          bindtap="togglePasswordVisible"
        />
      </view>
    </view>

    <!-- 忘记密码 -->
    <view class="forgot-password" bindtap="goForgotPassword">
      忘记密码？
    </view>

    <!-- 登录按钮 -->
    <button
      class="btn-login {{canSubmit ? 'active' : ''}}"
      disabled="{{!canSubmit || isLoading}}"
      bindtap="handleLogin"
    >
      {{isLoading ? '登录中...' : '登录'}}
    </button>

    <!-- 微信登录（纯文字按钮） -->
    <button class="btn-wechat" bindtap="handleWechatLogin" disabled="{{isLoading}}">
      微信一键登录
    </button>

    <!-- 注册入口 -->
    <view class="register-entry">
      还没有账号？
      <text class="link" bindtap="goRegister">立即注册</text>
    </view>
  </view>
</view>
