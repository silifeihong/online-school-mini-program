# 环境变量配置示例
# 复制此文件为 .env.local 并填入实际值

# ============================================
# MySQL 配置
# ============================================
# MySQL root 密码（Docker 环境使用）
MYSQL_ROOT_PASSWORD=change-me
# 数据库名称
MYSQL_DATABASE=online_school
# 数据库主机（本地开发用 localhost，Docker 用 mysql）
DATABASE_HOST=localhost
# 数据库端口
DATABASE_PORT=3306
# 数据库用户名
DATABASE_USER=root
# 数据库密码
DATABASE_PASSWORD=change-me

# ============================================
# JWT 配置
# ============================================
# JWT 密钥（生产环境必须更换为强密钥）
JWT_SECRET=your-jwt-secret-key-change-in-production
# Access Token 过期时间
JWT_ACCESS_EXPIRES_IN=2h
# Refresh Token 过期时间
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# 阿里云邮件推送配置
# ============================================
# 邮件服务商：mock（开发环境）| aliyun（生产环境）
EMAIL_PROVIDER=mock
# 阿里云 AccessKey ID
ALIYUN_EMAIL_ACCESS_KEY_ID=
# 阿里云 AccessKey Secret
ALIYUN_EMAIL_ACCESS_KEY_SECRET=
# 发信地址
ALIYUN_EMAIL_ACCOUNT_NAME=
# 发信人别名
ALIYUN_EMAIL_FROM_ALIAS=网校

# ============================================
# 微信小程序配置
# ============================================
# 小程序 AppID（在微信公众平台获取）
WECHAT_APPID=your-appid
# 小程序 AppSecret（在微信公众平台获取）
WECHAT_SECRET=your-secret

# ============================================
# 初始管理员（seed:admin 使用）
# ============================================
# 初始 admin 账户密码；不设置则跳过种子创建，代码中无默认口令
ADMIN_SEED_PASSWORD=
